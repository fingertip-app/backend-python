# 충북 FastAPI 실행에 필요한 설정만 남김 (DB/Redis/손끝 전용 설정은 제거)

# AI 챗봇(/ai/explain), 추천(/experiences/recommend)에 필요
OPENAI_API_KEY=

# 충북 프론트 도메인. 콤마로 여러 개 지정 가능 (예: http://localhost:3000,https://chungbuk.example.com)
CHUNGBUK_CORS_ORIGINS=

# 코드 폴더 밖 절대경로 권장 (예: /var/lib/chungbuk-api/data). 비워두면 프로젝트 루트 기준 기본값 사용
CHUNGBUK_DATA_DIR=

# 손끝과 같은 Supabase 프로젝트의 JWT secret (Auth는 공유).
# 예약 생성(POST /reservations), 내 예약 목록(GET /reservations/mine) 둘 다 필수 - 없으면 503
SUPABASE_JWT_SECRET=

# 장인 인증(certify) 등 관리자 전용 작업 보호용. 임의의 긴 랜덤 문자열로 직접 지정.
CHUNGBUK_ADMIN_KEY=
