# Local development defaults. Replace secret values in your ignored .env file.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://fingertip:fingertip@localhost:5432/fingertip
REDIS_URL=redis://localhost:6379/0

# Required for live AI endpoints; keep empty when running tests without OpenAI.
OPENAI_API_KEY=
INTERNAL_API_KEY=

# Optional settings. Omit these to use the defaults in app/core/config.py.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini
RAG_LOCALE_FALLBACK=ko
RAG_TOP_K=20
RAG_CANDIDATE_K=200
RAG_MAX_CHUNKS_PER_ITEM=3
RAG_CONTEXT_MAX_CHUNKS=30
RAG_SIMILARITY_THRESHOLD=0.20
RAG_VECTOR_RANK_WEIGHT=0.7
RAG_LEXICAL_RANK_WEIGHT=0.3
AI_FALLBACK_ENABLED=false
AI_FALLBACK_DATA_PATH=app/data/ai_fallback_responses.json
