# --- 기존(손끝) 설정 - 충북 배포에는 DATABASE_URL/REDIS_URL 불필요 ---
APP_ENV=
DATABASE_URL=
REDIS_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_GENERATION_MODEL=
RAG_TOP_K=
INTERNAL_API_KEY=
AI_FALLBACK_ENABLED=
AI_FALLBACK_DATA_PATH=

# --- 충북 전용 설정 ---
# 충북 프론트 Vercel 배포 도메인. 콤마로 여러 개 지정 가능 (예: http://localhost:3000,https://chungbuk.example.com)
CHUNGBUK_CORS_ORIGINS=
# 코드 폴더 밖 절대경로 권장 (예: /var/lib/chungbuk-api/data). 비워두면 프로젝트 루트 기준 기본값 사용
CHUNGBUK_DATA_DIR=
# 손끝과 같은 Supabase 프로젝트의 JWT secret (Auth는 공유). "내 예약 목록" 기능에만 필요.
# 비워두면 예약 자체는 그대로 동작하고, /reservations/mine만 503으로 비활성화됨.
SUPABASE_JWT_SECRET=

# --- 데이터 수집 스크립트용 (1회성 실행, 앱 구동에는 불필요) ---
# scripts/fetch_chungbuk_tradimarket.py 에서 사용 (공공데이터포털 디코딩 키)
TRADI_MARKET_SERVICE_KEY=
