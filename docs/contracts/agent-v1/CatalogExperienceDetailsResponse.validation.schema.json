{
  "$defs": {
    "RegionCode": {
      "enum": [
        "SEOUL",
        "GYEONGGI",
        "INCHEON",
        "BUSAN",
        "JEJU"
      ],
      "title": "RegionCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "exclusiveMinimum": 0,
      "title": "Id",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "descriptionExcerpt": {
      "maxLength": 1200,
      "title": "Descriptionexcerpt",
      "type": "string"
    },
    "tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "priceKrw": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Pricekrw"
    },
    "maxParticipants": {
      "minimum": 1,
      "title": "Maxparticipants",
      "type": "integer"
    },
    "regionCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegionCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "isActive": {
      "title": "Isactive",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "descriptionExcerpt",
    "tags",
    "priceKrw",
    "maxParticipants",
    "regionCode",
    "isActive",
    "description"
  ],
  "title": "CatalogExperienceDetailsResponse",
  "type": "object"
}
